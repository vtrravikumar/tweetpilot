{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweetpilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://vtrrk.in",
    "VICHAR_DAILY_LIMIT": "10",
    "VICHAR_BURST_PER_MINUTE": "30"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VicharUsage",
        "class_name": "VicharUsage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VicharUsage"
      ]
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.png"
      ],
      "fallthrough": true
    }
  ]
}
